{
  "name": "yomi",
  "private": true,
  "version": "0.1.0",
  "description": "A private, local-first chapter log for comics read across sites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SobremonteKate/Yomi.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke-local.mjs",
    "smoke:attached": "node scripts/smoke-worker.mjs",
    "worker:dev": "wrangler dev",
    "worker:db:local": "wrangler d1 execute yomi --local --file ./worker/schema.sql",
    "worker:db:remote": "wrangler d1 execute yomi --remote --file ./worker/schema.sql",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "idb": "^8.0.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "esbuild": "^0.28.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
